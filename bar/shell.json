{
  "version": 1,
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "user.arch-menu",
          "type": "qml",
          "source": "~/.config/omarchy/bar/modules/arch-menu.qml"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd hh:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.voxtype"
        },
        {
          "id": "omarchy.indicators"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "id": "user.pill-bar"
  },
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "plugins": []
}
